    <key>NSMicrophoneUsageDescription</key><string>KAARIS utilise le microphone quand tu actives la dictée du coach.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>KAARIS transcrit la dictée du coach sur cet appareil.</string>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
    <key>KaarisAPIURL</key><string>$(KAARIS_API_URL)</string>
    <key>SupabaseURL</key><string>$(SUPABASE_URL)</string>
    <key>SupabasePublishableKey</key><string>$(SUPABASE_PUBLISHABLE_KEY)</string>
</dict>
</plist>
